rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    match /usuarios/{uid} {
      allow read: if autenticado();
      allow create: if autenticado() && request.auth.uid == uid;
      allow update, delete: if autenticado() && request.auth.uid == uid;
    }

    match /publicacoes/{publicacaoId} {
      allow read: if autenticado();
      allow create: if autenticado()
        && request.resource.data.autorId == request.auth.uid;
      allow update: if autenticado()
        && resource.data.autorId == request.auth.uid;
      allow delete: if autenticado()
        && resource.data.autorId == request.auth.uid;

      match /comentarios/{comentarioId} {
        allow read: if autenticado();
        allow create: if autenticado()
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.publicacaoId == publicacaoId
          && request.resource.data.keys().hasAll(['texto', 'autorNome', 'autorId', 'publicacaoId', 'data'])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 500
          && request.resource.data.autorNome is string;
        allow delete: if autenticado()
          && resource.data.autorId == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
